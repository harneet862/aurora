<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" type="image/png" href="/flower.png" />
		<link rel="icon" href="/flower.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Harneet Kaur</title>
	</head>
	<body>
		<div class="site-shell">
			<slot />
		</div>
	</body>
</html>

<script>
	function setChromeHeights() {
		const nav = document.querySelector('nav.nav');
		const footer = document.querySelector('footer');
		const root = document.documentElement;
		if (nav) root.style.setProperty('--header-h', `${nav.getBoundingClientRect().height}px`);
		if (footer) root.style.setProperty('--footer-h', `${footer.getBoundingClientRect().height}px`);
	}
	setChromeHeights();
	window.addEventListener('resize', setChromeHeights);
</script>

<style is:global>
	:root {
		/* Shared page width used by every section's inner content. */
		--content-max: 850px;
		/* Measured on load/resize by Layout.astro's script; these are just first-paint fallbacks. */
		--header-h: 73px;
		--footer-h: 70px;
	}
</style>

<style>
	html{
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #1E1E2E;
		/* Keep page width consistent when routes have different amounts of content. */
		scrollbar-gutter: stable;
		overflow-x: hidden;
		scroll-behavior: smooth;
		/* Proximity (not mandatory) so #experiences, which isn't viewport-height, doesn't fight the user's scroll. */
		scroll-snap-type: y proximity;
		/* Reserve space for the sticky header so anchor links and scroll-snap both land below it. */
		scroll-padding-top: var(--header-h);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background-color: #1E1E2E;
	}

	.site-shell {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
</style>
