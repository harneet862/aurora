<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" type="image/png" href="/flower.png" />
		<link rel="icon" href="/flower.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Harneet Kaur</title>
	</head>
	<body>
		<div class="scroll-progress" aria-hidden="true"></div>
		<div class="site-shell">
			<slot />
		</div>
	</body>
</html>

<noscript>
	<style>
		.reveal { filter: none !important; transform: none !important; }
	</style>
</noscript>

<script>
	function setChromeHeights() {
		const nav = document.querySelector('nav.nav');
		const footer = document.querySelector('footer');
		const root = document.documentElement;
		if (nav) root.style.setProperty('--header-h', `${nav.getBoundingClientRect().height}px`);
		if (footer) root.style.setProperty('--footer-h', `${footer.getBoundingClientRect().height}px`);
	}
	setChromeHeights();
	window.addEventListener('resize', setChromeHeights);

	// Shared scroll-reveal: every .reveal element is observed once and released
	// the moment it enters the viewport. One observer for the whole site instead
	// of duplicating this logic per component.
	const revealTargets = document.querySelectorAll('.reveal');
	if (revealTargets.length) {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.15 }
		);
		revealTargets.forEach((el) => revealObserver.observe(el));

		// An element near the true end of a short page (e.g. the footer) can sit
		// below this observer's shrunk trigger zone with no more page left to
		// scroll it into that zone — it would stay hidden forever. Once the page
		// is scrolled to its end, reveal anything still waiting.
		const revealAtBottom = () => {
			const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
			if (!atBottom) return;
			document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => {
				el.classList.add('is-visible');
				revealObserver.unobserve(el);
			});
		};
		revealAtBottom();
		window.addEventListener('scroll', revealAtBottom, { passive: true });
	}

	// Thin top progress bar tracking scroll position through the whole page.
	const progressBar = document.querySelector('.scroll-progress');
	if (progressBar) {
		let ticking = false;
		const updateProgress = () => {
			const scrollable = document.documentElement.scrollHeight - window.innerHeight;
			const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
			progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
			ticking = false;
		};
		updateProgress();
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(updateProgress);
					ticking = true;
				}
			},
			{ passive: true }
		);
	}
</script>

<style is:global>
	:root {
		/* Shared page width used by every section's inner content. */
		--content-max: 850px;
		/* Measured on load/resize by Layout.astro's script; these are just first-paint fallbacks. */
		--header-h: 73px;
		--footer-h: 70px;
	}

	/* Shared entrance animation: an element starts hidden/offset, then eases in
	   once .is-visible is added by the reveal observer in the script above.
	   --reveal-delay and --reveal-distance let callers stagger without new CSS. */
	/* filter: opacity() rather than the opacity property itself, so this never
	   fights with an element's own opacity (several already use it, e.g. muted
	   eyebrow/greeting text) — the two compose independently instead of colliding. */
	.reveal {
		filter: opacity(0%);
		transform: translateY(var(--reveal-distance, 20px));
		transition: filter 0.6s ease-out, transform 0.6s ease-out;
		transition-delay: var(--reveal-delay, 0ms);
	}

	.reveal.is-visible {
		filter: opacity(100%);
		transform: translateY(0);
	}

	.scroll-progress {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background: #EEDEDB;
		transform: scaleX(0);
		transform-origin: left;
		z-index: 30;
	}

	/* Respect the user's OS-level motion preference in one place, rather than
	   duplicating a media query in every component that animates. */
	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>

<style>
	html{
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #1E1E2E;
		/* Keep page width consistent when routes have different amounts of content. */
		scrollbar-gutter: stable;
		overflow-x: hidden;
		scroll-behavior: smooth;
		/* Only reserve space for sticky-header anchor jumps; no page-level snap, since each section is intended to occupy its own screen. */
		scroll-padding-top: var(--header-h);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background-color: #1E1E2E;
	}

	.site-shell {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
</style>
