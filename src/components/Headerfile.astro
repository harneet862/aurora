---
import Flower from './Flower.astro';
---

<nav class="nav">
	<div class="left">
		<a href="/">harneetk</a>
		<Flower />
	</div>
	<div class="right">
		<a href="/">HOME</a>
		<a href="/about">ABOUT ME</a>
		<a href="/skills">SKILLS</a>
		<a href="/experiences">EXPERIENCE</a>
		<a href="/projects">PROJECTS</a>
		<a href="/contact">CONTACT ME</a>
	</div>
	<button class="menu" aria-label="Toggle menu">
		<div class="line"></div>
		<div class="line"></div>
		<div class="line"></div>
	</button>
</nav>

<div class="side-menu-overlay"></div>

<div class="side-menu">
    <button class="close-btn" aria-label="Close menu">&times;</button>
	<div class="side-menu-links">
		<a href="/">Home</a>
        <a href="/about">About Me</a>
		<a href="/skills">Skills</a>
		<a href="/experiences">Experience</a>
		<a href="/projects">Projects</a>
		<a href="/contact">Contact Me</a>
    </div>
</div>

<script>
	const menuBtn = document.querySelector(".menu");
	const clBtn = document.querySelector(".close-btn");
	const overlay = document.querySelector(".side-menu-overlay");
	const sideMenu = document.querySelector(".side-menu");
	
	function toggleMenu() {
		overlay?.classList.toggle('active');
		sideMenu?.classList.toggle('active');
	}
	
	menuBtn?.addEventListener('click', toggleMenu);
	clBtn?.addEventListener('click', toggleMenu);
	overlay?.addEventListener('click', toggleMenu);
</script>

<style>
	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 20px 60px;
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.left {
		display: flex;
		align-items: flex-end;
		gap: 0.1rem;
	}

	.left a {
		color: #EEDEDB;
		font-size: 1.8rem;
		font-family:"Libre Franklin", sans-serif;
		font-weight: 700;
		text-decoration: none;
	}

	.right {
		display: flex;
		gap: 20px;
		align-items: center;
	}

	.right a {
		color: #CFD6EE;
		font-size: 1.2rem;
		font-family: 'Times New Roman', Times, serif;
		text-decoration: none;
	}

	.right a:hover {
		color: #EEDEDB;
	}

	.menu {
		display: none;
		flex-direction: column;
		background: transparent;
		border: none;
		padding: 0;
		cursor: pointer;
		z-index: 1001;
	}
	
	.line {
		width: 30px;
		height: 3px;
		background-color: #CFD6EE;
		margin: 3px 0;
		transition: 0.3s;
	}

	.side-menu-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		background-color: rgba(30, 30, 46, 0.5);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s, visibility 0.3s;
		z-index: 999;
	}

	.side-menu-overlay.active {
		opacity: 1;
		visibility: visible;
	}

	.side-menu {
		position: fixed;
		top: 0;
		right: -100%;
		width: min(250px, 70vw);
		height: 100vh;
		background-color: #CFD6EE;
		padding: 3.75rem 1.875rem;
		transition: right 0.3s ease;
		z-index: 1000;
	}

	.side-menu.active {
		right: 0;
	}

	.side-menu-links {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		align-items: center;
		margin-top: 2rem;
	}

	.side-menu-links a {
		color: #1E1E2E;
		font-family: sans-serif;
		text-decoration: none;
		font-size: 1.3rem;
		font-weight: 530;
		transition: transform 0.2s, color 0.2s;
		letter-spacing: 0.3px;
	}

	.side-menu-links a:hover {
		color: #4a4a5e;
		transform: translateX(-5px);
	}

	.close-btn {
		position: absolute;
		top: 1.25rem;
		right: 1.25rem;
		background: rgba(30, 30, 46, 0.1);
		border: none;
		border-radius: 50%;
		color: #1E1E2E;
		font-size: 2.5rem;
		cursor: pointer;
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.close-btn:hover {
		background: rgba(30, 30, 46, 0.2);
	}

	@media screen and (max-width:950px) and (min-width:450px){

		.nav {
			padding: 20px 40px;
		}

		.right {
			display: none;
		}

		.menu {
			display: flex;
		}

		.line {
			width: 25px;
			height: 2.5px;
			margin: 2.0px 0;
		}
	}
	@media screen and (max-width: 450px) and (min-width: 0px) {
		.nav {
			padding: 15px 20px;
		}

		.left a {
			font-size: 1.5rem;
		}

		.right {
			display: none;
		}

		.menu {
			display: flex;
		}

		.line {
			width: 20px;
			height: 2px;
			margin: 2.0px 0;
		}
	}

	@media screen and (min-width: 951px) {
		.side-menu,
		.side-menu-overlay {
			display: none;
		}
	}
</style>