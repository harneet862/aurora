---
import Flower from './Flower.astro';
---

<nav class="nav">
	<div class="nav-inner">
		<div class="left">
			<a href="/">harneetk</a>
			<Flower />
		</div>
		<div class="right">
			<a href="/#home">HOME</a>
			<a href="/#about">ABOUT ME</a>
			<a href="/#skills">SKILLS</a>
			<a href="/#experiences">EXPERIENCE</a>
			<a href="/#projects">PROJECTS</a>
			<a href="https://drive.google.com/file/d/1b6ERl75TC3YChykdarCZ8Lue6r_JfGS0/view?usp=sharing" target="_blank" rel="noopener noreferrer">RESUME</a>
		</div>
		<button class="menu" aria-label="Toggle menu">
			<div class="line"></div>
			<div class="line"></div>
			<div class="line"></div>
		</button>
	</div>
</nav>

<div class="side-menu-overlay"></div>

<div class="side-menu">
    <div class="menu-top">
        <button class="close-btn" aria-label="Close menu">&times;</button>
    </div>
	<div class="side-menu-links" aria-label="Mobile navigation">
		<a href="/#home"><span>01</span>Home</a>
		<a href="/#about"><span>02</span>About Me</a>
		<a href="/#skills"><span>03</span>Skills</a>
		<a href="/#experiences"><span>04</span>Experience</a>
		<a href="/#projects"><span>05</span>Projects</a>
		<a href="https://drive.google.com/file/d/1b6ERl75TC3YChykdarCZ8Lue6r_JfGS0/view?usp=sharing" target="_blank" rel="noopener noreferrer"><span>06</span>Resume</a>
    </div>
</div>

<script>
	const menuBtn = document.querySelector(".menu");
	const clBtn = document.querySelector(".close-btn");
	const overlay = document.querySelector(".side-menu-overlay");
	const sideMenu = document.querySelector(".side-menu");
	
	function toggleMenu() {
		overlay?.classList.toggle('active');
		sideMenu?.classList.toggle('active');
	}
	
	menuBtn?.addEventListener('click', toggleMenu);
	clBtn?.addEventListener('click', toggleMenu);
	overlay?.addEventListener('click', toggleMenu);

	document.querySelectorAll('.side-menu-links a').forEach((link) => {
		link.addEventListener('click', () => {
			if (sideMenu?.classList.contains('active')) toggleMenu();
		});
	});
</script>

<style>
	.nav {
		padding: 20px;
		position: sticky;
		top: 0;
		z-index: 20;
		background: #1E1E2E;
	}

	.nav-inner {
		max-width: var(--content-max);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.left {
		display: flex;
		align-items: flex-end;
		gap: 0.1rem;
	}

	.left a {
		color: #EEDEDB;
		font-size: 1.8rem;
		font-family:"Libre Franklin", sans-serif;
		font-weight: 700;
		text-decoration: none;
	}

	.right {
		display: flex;
		gap: 20px;
		align-items: center;
	}

	.right a {
		color: #CFD6EE;
		font-size: 1.2rem;
		font-family: 'Times New Roman', Times, serif;
		text-decoration: none;
	}

	.right a:hover {
		color: #EEDEDB;
	}

	.menu {
		display: none;
		flex-direction: column;
		background: transparent;
		border: none;
		padding: 0;
		cursor: pointer;
		/* z-index: 1001; */
	}
	
	.line {
		width: 30px;
		height: 3px;
		background-color: #CFD6EE;
		margin: 3px 0;
		transition: 0.3s;
	}

	.side-menu-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		background-color: rgba(30, 30, 46, 0.676);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s, visibility 0.3s;
		z-index: 999;
	}

	.side-menu-overlay.active {
		opacity: 1;
		visibility: visible;
	}

	.side-menu {
		position: fixed;
		top: 0;
		right: 0;
		width: min(19rem, 82vw);
		height: 100vh;
		box-sizing: border-box;
		background-color: #1E1E2E;
		border-left: 1px solid rgba(207, 214, 238, 0.3);
		padding: 1.5rem;
		transform: translateX(100%);
		transition: transform 0.3s ease;
		will-change: transform;
		z-index: 1000;
	}

	.side-menu.active {
		transform: translateX(0);
	}

	.menu-top {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding-bottom: 0.35rem;
	}

	.side-menu-links {
		display: flex;
		flex-direction: column;
		gap: 0;
		margin-top: 0.75rem;
	}

	.side-menu-links a {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		padding: 1rem 0;
		border-bottom: 1px solid rgba(207, 214, 238, 0.14);
		color: #EEDEDB;
		font-family: Georgia, 'Times New Roman', serif;
		text-decoration: none;
		font-size: 1.3rem;
		transition: padding 0.2s, color 0.2s;
	}

	.side-menu-links a span {
		color: #CFD6EE;
		opacity: 0.6;
		font: 0.7rem 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
		letter-spacing: 0.08em;
	}

	.side-menu-links a:hover {
		color: #CFD6EE;
		transform: translateX(0.4rem);
	}

	.close-btn {
		background: transparent;
		border: none;
		color: #CFD6EE;
		font-size: 2rem;
		cursor: pointer;
		width: 2rem;
		height: 2rem;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.close-btn:hover {
		color: #EEDEDB;
	}

	@media (min-width: 850px) {
		.nav {
			padding-left: clamp(1rem, 2vw, 8rem);
			padding-right: clamp(1rem, 2vw, 8rem);
		}
	}
	
	@media screen and (max-width: 850px){

		.left a {
			font-size: 1.6rem;
		}

		.right {
			display: none;
		}

		.menu {
			display: flex;
		}

		.line {
			width: 20px;
			height: 2px;
			margin: 2.0px 0;
		}
	}

	@media screen and (min-width: 951px) {
		.side-menu,
		.side-menu-overlay {
			display: none;
		}
	}
</style>
