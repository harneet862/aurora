---
import Layout from '../layouts/Layout.astro';
import Headerfile from '../components/Headerfile.astro';
import Footerfile from '../components/Footerfile.astro';
---

<Layout>
    <Headerfile />
    <main>
        <section aria-labelledby="projects-heading">
            <p>PROJECTS</p>
            <h1 id="projects-heading">Coming soon...</h1>
        </section>
    </main>
    <Footerfile />
</Layout>

<style>
    main {
        flex: 1;
        display: grid;
        place-items: center;
        padding: 2rem 1.25rem;
        text-align: center;
    }

    p {
        margin: 0 0 0.45rem;
        color: #CFD6EE;
        opacity: 0.7;
        font: clamp(0.8rem, 1.1vw, 1.1rem) 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    }

    h1 {
        margin: 0;
        color: #EEDEDB;
        font: clamp(1.8rem, 3vw, 5.5rem) Georgia, 'Times New Roman', serif;
        font-weight: 400;
    }
</style>
