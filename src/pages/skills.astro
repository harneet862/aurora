---
import Layout from '../layouts/Layout.astro';
import Headerfile from '../components/Headerfile.astro';
import Footerfile from '../components/Footerfile.astro';

const skillGroups = [
    { title: 'Languages', skills: ['Python', 'Java', 'C/C++', 'JavaScript', 'TypeScript', 'SQL'] },
    { title: 'Frontend', skills: ['HTML', 'CSS', 'Astro', 'React', 'Responsive Web Design'] },
    { title: 'Backend', skills: ['Flask', 'Django', 'Node.js', 'REST APIs'] },
    { title: 'DevOps', skills: ['Git', 'GitHub', 'Docker', 'CI/CD', 'Linux', 'Cloud Deployment'] },
    { title: 'Databases', skills: ['MySQL', 'PostgreSQL', 'MongoDB', 'Firebase'] },
];
---

<Layout>
    <Headerfile />
    <main>
        <section class="skills-section" aria-labelledby="skills-heading">
            <div class="heading">
                <p id="overview">WHAT I WORK WITH</p>
                <h1 id="skills-heading">Skills & Tools</h1>
            </div>

            <div class="skills-grid">
                {skillGroups.map((group) => (
                    <section class="skill-group" aria-labelledby={`skill-${group.title}`}>
                        <h2 id={`skill-${group.title}`}>{group.title}</h2>
                        <ul>
                            {group.skills.map((skill) => <li>{skill}</li>)}
                        </ul>
                    </section>
                ))}
            </div>
        </section>
    </main>
    <Footerfile />
</Layout>

<style>
    main {
        min-height: calc(100vh - 160px);
        padding: 3rem 1.25rem 6rem;
    }

    .skills-section {
        max-width: 850px;
        margin: 0 auto;
    }

    .heading {
        margin-bottom: 3.5rem;
        text-align: center;
    }

    #overview{
        font-size: clamp(0.8rem, 1.1vw, 1.1rem);
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: #CFD6EE;
        opacity: 0.7;
        margin-bottom: 1%;
   }

   #skills-heading{
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #EEDEDB;
        font-size: clamp(1.8rem, 3vw, 5.5rem);
        margin: 0.1%;
    }

    h1 {
        margin: 0;
        color: #EEDEDB;
        font: clamp(1.8rem, 3vw, 5.5rem) Georgia, 'Times New Roman', serif;
        font-weight: 400;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: clamp(3rem, 10vw, 8rem);
        row-gap: 3.5rem;
    }

    .skill-group h2 {
        margin: 0 0 1.25rem;
        color: #EEDEDB;
        font: clamp(1.35rem, 2vw, 1.65rem) Georgia, 'Times New Roman', serif;
        font-weight: 400;
    }

    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        padding: 0.48rem 0.9rem;
        border: 1px solid rgba(207, 214, 238, 0.4);
        border-radius: 999px;
        color: #CFD6EE;
        font: 0.92rem 'Lucida Sans', 'Lucida Grande', sans-serif;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    li:hover {
        color: #1E1E2E;
        background: #CFD6EE;
    }

    @media (max-width: 600px) {
        main {
            padding-top: 2rem;
        }

        .heading {
            margin-bottom: 2.5rem;
        }

        .skills-grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }
    }
</style>
