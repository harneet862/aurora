---
import Layout from '../layouts/Layout.astro';
import Headerfile from '../components/Headerfile.astro';
import Footerfile from '../components/Footerfile.astro';
---

<Layout>
    <Headerfile />
    <main>
        <div id="about">
            <p id="aboutme">About Me</p>
                <ul id="text">
                    <li>
                        I'm a 3rd-year Computer Science student at the University of Alberta, passionate about using technology to solve real problems and building intelligent systems that create positive impact.
                    </li>
                    <li>
                        My journey into CS began with Harvard's CS50 course, which sparked my interest in programming. Since then, I've been exploring machine learning, data analysis, and how AI can be used for social good.
                    </li>
                    <li>
                        Outside of coding, I enjoy reading non-fiction, going for walks, and exploring new food places around the city.
                    </li>
                </ul>
        </div>
    </main>
    <Footerfile />
</Layout>

<style>

    li{
        margin-bottom: 1.5rem;
    }

    main{
        min-width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    #about{
        display:flex;
        flex-direction: column;
        max-width: 850px;
        
    }

    #aboutme{
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #EEDEDB;
        font-size: clamp(2.5rem, 3vw, 5.5rem);
        margin: 0.1%;
        align-self: center;       
    }

    #text{
        color: #CFD6EE;
        font-size: clamp(1.2rem, 1.2vw, 3.5rem);
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        line-height: 1.5;
    }
</style>