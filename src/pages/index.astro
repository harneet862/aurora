---
import Layout from '../layouts/Layout.astro';
import Headerfile from '../components/Headerfile.astro';
import Flower from '../components/Flower.astro';
import Footerfile from '../components/Footerfile.astro';
---

<Layout>
    <Headerfile />
        <main>
            <div id="home">
                <div id="text">
                    <p id="greetings">HELLO!</p>
                    <div id="nameflower">
                        <p id="name">I'm Harneet</p>
                        <Flower/>
                    </div>
                    <p id="introduction">Aspiring software engineer passionate about AI, data, and social impact.</p>
                </div>
                <div id="mypic">
                    <img src="me.jpeg" alt="Harneet's photo">
                </div>
            </div>
        </main>
   <Footerfile /> 
</Layout>

<style>
    main{
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 100px);;
    }

    #home{
        display: flex;
        align-items: center;
        max-width: 850px;    
        justify-content: center;
        gap: 5%;
        padding: 20px 14vw;
    }

    @media screen and (min-width: 850px) {

        #home{
            padding-left: clamp(1rem, 14vw, 9rem);
            padding-right: clamp(1rem, 14vw, 9rem);
        }
    }

    #text{
        flex: 1;
        max-width: 600px;
    }

    #mypic{
        max-width: 18rem;
        max-height: 28rem;
        flex-shrink: 0;
    }

    #mypic img{
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
    }

    @media screen and (max-width:800px) {
        #mypic img{
            display: none;
        }
    }

    #nameflower{
        display: flex;
        gap: 5px;
        align-items: flex-end;
    }

    #greetings{
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: #CFD6EE;
        opacity: 0.7;
        font-size: clamp(1.5rem, 3vw, 3.5rem);
        padding-bottom: 1.5%;
    }

    #name{
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #EEDEDB;
        font-size: clamp(2.5rem, 5vw, 5.5rem);
        margin-bottom: 2%;
    }

    #introduction{
        color: #CFD6EE;
        font-size: clamp(1.2rem, 1.6vw, 3.5rem);
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        line-height: 1.5;
    }

    p{
        margin: 0;
    }
</style>