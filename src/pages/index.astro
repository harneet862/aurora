---
import Layout from '../layouts/Layout.astro';
import Headerfile from '../components/Headerfile.astro';
import Flower from '../components/Flower.astro';
import Footerfile from '../components/Footerfile.astro';
import Timeline from '../components/Timeline.astro';

const skillGroups = [
    { title: 'Languages', skills: ['Python', 'Java', 'C/C++', 'JavaScript', 'TypeScript', 'SQL'] },
    { title: 'Frontend', skills: ['HTML', 'CSS', 'Astro', 'React', 'Responsive Web Design'] },
    { title: 'Backend', skills: ['Flask', 'Django', 'Node.js', 'REST APIs'] },
    { title: 'DevOps', skills: ['Git', 'GitHub', 'Docker', 'CI/CD', 'Linux', 'Cloud Deployment'] },
    { title: 'Databases', skills: ['MySQL', 'PostgreSQL', 'MongoDB', 'Firebase'] },
];
---

<Layout>
    <Headerfile />
    <main>
        <section id="home">
            <div id="text">
                <p id="greetings">HELLO!</p>
                <div id="nameflower">
                    <p id="name">I'm Harneet</p>
                    <Flower/>
                </div>
                <p id="introduction">I build thoughtful software at the intersection of engineering, AI, and real-world impact.</p>
            </div>
            <div id="mypic">
                <img src="me.jpeg" alt="Harneet's photo">
            </div>
        </section>

        <section id="about" aria-labelledby="about-heading">
            <div class="about-content">
                <p class="eyebrow">AN OVERVIEW OF ME</p>
                <p class="section-heading" id="about-heading">Introduction</p>
                <p class="text">I’m a 4th-year Computer Science student at the University of Alberta who enjoys using technology to solve real-world problems and build things that are actually useful.</p>
                <p class="text">My interest in programming started with Harvard’s CS50 course, which introduced me to coding and problem-solving. Since then, I’ve been learning more about machine learning, software engineering, and how technology can be used to help people.</p>
                <p class="text">Outside of coding, I like reading books, going for walks, and checking out new food spots around the city.</p>
            </div>
        </section>

        <section id="skills" aria-labelledby="skills-heading">
            <div class="skills-inner">
                <div class="heading">
                    <p class="eyebrow">WHAT I WORK WITH</p>
                    <h1 class="section-heading" id="skills-heading">Skills & Tools</h1>
                </div>

                <div class="skills-grid">
                    {skillGroups.map((group) => (
                        <section class="skill-group" aria-labelledby={`skill-${group.title}`}>
                            <h2 id={`skill-${group.title}`}>{group.title}</h2>
                            <ul>
                                {group.skills.map((skill) => <li>{skill}</li>)}
                            </ul>
                        </section>
                    ))}
                </div>
            </div>
        </section>

        <section id="experiences" aria-labelledby="experiences-heading">
            <div class="experiences-heading">
                <p class="eyebrow">WHAT I'VE DONE SO FAR</p>
                <p class="section-heading" id="experiences-heading">Work Experience</p>
            </div>
            <Timeline />
        </section>

        <section id="projects" aria-labelledby="projects-heading">
            <p class="eyebrow">PROJECTS</p>
            <h1 class="section-heading" id="projects-heading">Coming soon...</h1>
        </section>
    </main>
    <Footerfile />
</Layout>

<style>
    main {
        display: flex;
        flex-direction: column;
    }

    main > section {
        scroll-margin-top: var(--header-h);
        scroll-snap-align: start;
    }

    .eyebrow {
        font-size: clamp(0.8rem, 1.1vw, 1.1rem);
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: #CFD6EE;
        opacity: 0.7;
        margin-bottom: 0.5em;
    }

    .section-heading {
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #EEDEDB;
        font-size: clamp(1.8rem, 3vw, 5.5rem);
        font-weight: 400;
        margin: 0 0 0.3em;
    }

    p {
        margin: 0;
    }

    /* Home */
    #home {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: min(calc(100vh - var(--header-offset-hero)), 42rem);
        gap: 5%;
        padding: clamp(1.25rem, 4vh, 2rem) clamp(1.25rem, 14vw, 9rem);
    }

    #text {
        flex: 1;
        max-width: 600px;
    }

    #mypic {
        max-width: 18rem;
        max-height: 28rem;
        flex-shrink: 0;
    }

    #mypic img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
    }

    @media screen and (max-width: 800px) {
        #mypic img {
            display: none;
        }
    }

    #nameflower {
        display: flex;
        gap: 5px;
        align-items: flex-end;
    }

    #greetings {
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: #CFD6EE;
        opacity: 0.7;
        font-size: clamp(1.5rem, 3vw, 3.5rem);
        padding-bottom: 1.5%;
    }

    #name {
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #EEDEDB;
        font-size: clamp(2.5rem, 5vw, 5.5rem);
        margin-bottom: 2%;
    }

    #introduction {
        color: #CFD6EE;
        font-size: clamp(1.2rem, 1.6vw, 3.5rem);
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        line-height: 1.5;
    }

    /* About */
    #about {
        display: flex;
        justify-content: center;
        padding: 0 clamp(1.25rem, 14vw, 9rem);
        height: min(calc(100vh - var(--header-offset-hero)), 42rem);
    }

    .about-content {
        display: flex;
        justify-content: center;
        flex-direction: column;
        width: min(100%, var(--content-max));
        margin: 0 auto;
    }

    #about .eyebrow,
    #about .section-heading {
        align-self: center;
        text-align: center;
    }

    .text {
        color: #CFD6EE;
        font-size: clamp(1rem, 1.2vw, 3.5rem);
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        line-height: 1.5;
        width: 100%;
        margin: 0 0 1rem;
    }

    /* Skills */
    #skills {
        display: flex;
        align-items: center;
        padding: clamp(1.5rem, 6vh, 3rem) clamp(1.25rem, 14vw, 9rem);
        min-height: min(calc(100vh - var(--header-offset-hero)), 42rem);
    }

    .skills-inner {
        max-width: var(--content-max);
        margin: 0 auto;
        width: 100%;
    }

    .heading {
        margin-bottom: clamp(1rem, 5vh, 3.5rem);
        text-align: center;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: clamp(1.5rem, 8vw, 8rem);
        row-gap: clamp(0.75rem, 4vh, 3.5rem);
    }

    .skill-group h2 {
        margin: 0 0 clamp(0.4rem, 2vh, 1.25rem);
        color: #EEDEDB;
        font: clamp(1rem, 1vw + 1.4vh, 1.65rem) Georgia, 'Times New Roman', serif;
        font-weight: 400;
    }

    .skill-group ul {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(0.35rem, 1vh, 0.75rem);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .skill-group li {
        padding: clamp(0.25rem, 1vh, 0.48rem) clamp(0.5rem, 1.5vw, 0.9rem);
        border: 1px solid rgba(207, 214, 238, 0.4);
        border-radius: 999px;
        color: #CFD6EE;
        font: clamp(0.72rem, 0.5vw + 0.9vh, 0.92rem) 'Lucida Sans', 'Lucida Grande', sans-serif;
        transition: background-color 0.2s ease, color 0.2s ease;
        white-space: nowrap;
    }

    .skill-group li:hover {
        color: #1E1E2E;
        background: #CFD6EE;
    }

    @media (max-width: 600px) {
        .skills-grid {
            column-gap: clamp(1rem, 5vw, 2rem);
        }

        .skill-group li {
            white-space: normal;
        }
    }

    /* Experiences */
    #experiences {
        display: flex;
        flex-direction: column;
        height: calc(100vh - var(--header-h) - var(--footer-h));
        padding: clamp(1.5rem, 6vh, 3rem) clamp(1.25rem, 14vw, 9rem);
        box-sizing: border-box;
    }

    .experiences-heading {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: var(--content-max);
        margin: 0 auto clamp(1rem, 4vh, 2rem);
    }

    /* Projects */
    #projects {
        display: grid;
        place-items: center;
        height: calc(100vh - var(--header-h) - var(--footer-h));
        padding: clamp(1.5rem, 6vh, 3rem) clamp(1.25rem, 14vw, 9rem);
        box-sizing: border-box;
        text-align: center;
    }
</style>
