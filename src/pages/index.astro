<style>
    #aboutMe{
        display:flex;
        flex-direction: column;
    }

    #body{
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 40px;
        margin-bottom: 10px;
    }


    #home{
        display: flex;
        padding: 20px 40px;
        align-items: center;
        justify-content: center;
        gap: 5%;
        max-width: 1400px;
        margin: 0 auto;
    }

    #text{
        flex: 1;
        max-width: 600px;
    }

    #mypic{
        max-width: 400px;
        max-height: 500px;
        flex-shrink: 0;
    }

    #mypic img{
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
        display: block;
    }

    #nameflower{
        display: flex;
        gap: 5px;
        align-items: flex-end;
    }

    #greetings{
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: #CFD6EE;
        opacity: 0.7;
        font-size: 24pt;
        padding-bottom: 20px;
    }

    #name{
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #EEDEDB;
        font-size: 42px;
        line-height: 1.2;
        margin-bottom: 10px;
    }

    #introduction{
        color: #CFD6EE;
        font-size: 24pt;
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        line-height: 1.5;
    }

    p{
        margin: 0;
    }
</style>