---
import Layout from '../layouts/Layout.astro';
import Headerfile from '../components/Headerfile.astro';
import Flower from '../components/Flower.astro';
import Footerfile from '../components/Footerfile.astro';
import Timeline from '../components/Timeline.astro';

const skillGroups = [
    { title: 'Languages', skills: ['Python', 'Java', 'C/C++', 'JavaScript', 'TypeScript', 'SQL'] },
    { title: 'Frontend', skills: ['HTML', 'CSS', 'Astro', 'React', 'Responsive Web Design'] },
    { title: 'Backend', skills: ['Flask', 'Django', 'Node.js', 'REST APIs'] },
    { title: 'DevOps', skills: ['Git', 'GitHub', 'Docker', 'CI/CD', 'Linux', 'Cloud Deployment'] },
    { title: 'Databases', skills: ['MySQL', 'PostgreSQL', 'MongoDB', 'Firebase'] },
];
---

<Layout>
    <Headerfile />
    <main>
        <div class="scroll-stack">
            <section id="home">
                <div class="home-content">
                    <div id="text">
                        <p id="greetings" class="reveal reveal-dim">HELLO!</p>
                        <div id="nameflower" class="reveal" style="--reveal-delay: 120ms;">
                            <p id="name">I'm Harneet</p>
                            <Flower floating/>
                        </div>
                        <p id="introduction" class="reveal" style="--reveal-delay: 240ms;">I build thoughtful software at the intersection of engineering, AI, and real-world impact.</p>
                    </div>
                    <div id="mypic">
                        <img src="/me.jpeg" alt="Harneet's photo">
                    </div>
                </div>
            </section>

            <section id="about" aria-labelledby="about-heading">
                <div class="about-content">
                    <p class="eyebrow reveal reveal-dim">AN OVERVIEW OF ME</p>
                    <p class="section-heading reveal" id="about-heading">Introduction</p>
                    <p class="text reveal" style="--reveal-delay: 150ms;">I’m a 4th-year Computer Science student at the University of Alberta who enjoys using technology to solve real-world problems and build things that are actually useful.</p>
                    <p class="text reveal" style="--reveal-delay: 230ms;">My interest in programming started with Harvard’s CS50 course, which introduced me to coding and problem-solving. Since then, I’ve been learning more about machine learning, software engineering, and how technology can be used to help people.</p>
                    <p class="text reveal" style="--reveal-delay: 310ms;">Outside of coding, I like reading books, going for walks, and checking out new food spots around the city.</p>
                </div>
            </section>
        </div>

        <section id="skills" aria-labelledby="skills-heading">
            <div class="skills-inner">
                <div class="heading">
                    <p class="eyebrow">WHAT I WORK WITH</p>
                    <h1 class="section-heading" id="skills-heading">Skills & Tools</h1>
                </div>

                <div class="skills-grid">
                    {skillGroups.map((group, i) => (
                        <section class="skill-group reveal" style={`--reveal-delay: ${i * 100}ms;`} aria-labelledby={`skill-${group.title}`}>
                            <h2 id={`skill-${group.title}`}>{group.title}</h2>
                            <ul>
                                {group.skills.map((skill) => <li>{skill}</li>)}
                            </ul>
                        </section>
                    ))}
                </div>
            </div>
        </section>

        <section id="experiences" aria-labelledby="experiences-heading">
            <div class="experiences-heading reveal">
                <p class="eyebrow">WHAT I'VE DONE SO FAR</p>
                <p class="section-heading" id="experiences-heading">Work Experience</p>
            </div>
            <Timeline />
        </section>

        <section id="projects" aria-labelledby="projects-heading">
            <div class="reveal">
                <p class="eyebrow">PROJECTS</p>
                <h1 class="section-heading" id="projects-heading">Coming soon...</h1>
            </div>
        </section>
    </main>
    <Footerfile />
</Layout>

<script>
    // Home -> About scroll-triggered cover transition.
    // Below 50% progress through the wrapper, About tracks the scroll 1:1 (no transition).
    // Crossing 50% (in either direction) hands off to a single eased CSS transition that
    // finishes the reveal/hide, so About visually "overtakes" Home instead of just following
    // the scrollbar the whole way.
    (() => {
        const wrapper = document.querySelector<HTMLElement>('.scroll-stack');
        const panelB = document.getElementById('about');
        const panelA = document.getElementById('home');
        if (!wrapper || !panelB || !panelA) return;

        const THRESHOLD = 0.3;
        const EASE_MS = 550;
        const EASED_CURVE = 'cubic-bezier(0.16, 1, 0.3, 1)';
        const EASED_TRANSFORM = `transform ${EASE_MS}ms ${EASED_CURVE}`;
        const EASED_FILTER = `filter ${EASE_MS}ms ${EASED_CURVE}`;
        const MAX_BLUR_PX = 10;

        let over = false;
        let wasInStack = false;
        let settleTimer: number | undefined;
        let ticking = false;

        const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

        function trackedTransform(progress: number) {
            return `translateY(${(1 - progress) * 100}%)`;
        }

        // Both the transform target and the blur amount always reflect the live scroll
        // position (never frozen), so there's nothing to "catch up" on once the eased
        // hand-off window ends - that staleness was what made the crossing feel like a
        // snap instead of smooth. Home blurs out underneath as About slides over it,
        // rather than just sitting there sharp until it's abruptly covered.
        function apply(progress: number, inStack: boolean) {
            const desiredOver = progress >= THRESHOLD;
            const panelChanged = desiredOver !== over;

            if (panelChanged) {
                over = desiredOver;
                panelB.style.transition = EASED_TRANSFORM;
                panelA.style.transition = EASED_FILTER;
                window.clearTimeout(settleTimer);
                settleTimer = window.setTimeout(() => {
                    panelB.style.transition = 'none';
                    panelA.style.transition = 'none';
                }, EASE_MS);

            }

            if (inStack && (!wasInStack || panelChanged)) {
                window.dispatchEvent(new CustomEvent('home-about-active', {
                    detail: { id: desiredOver ? 'about' : 'home' },
                }));
            }

            wasInStack = inStack;

            panelB.style.transform = over ? 'translateY(0%)' : trackedTransform(progress);

            const blurPx = (over ? 1 : progress) * MAX_BLUR_PX;
            panelA.style.filter = blurPx > 0 ? `blur(${blurPx}px)` : 'none';
        }

        function update() {
            ticking = false;
            const rect = wrapper.getBoundingClientRect();
            const scrollable = rect.height - window.innerHeight;
            const progress = scrollable > 0 ? clamp01(-rect.top / scrollable) : 0;
            const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 0;
            const inStack = rect.top < window.innerHeight && rect.bottom > headerHeight;
            apply(progress, inStack);
        }

        function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
    })();
</script>

<style>
    main {
        display: flex;
        flex-direction: column;
    }

    main > section {
        min-height: calc(100vh - var(--header-h));
    }

    .eyebrow {
        font-size: clamp(0.8rem, 1.1vw, 1.1rem);
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: #CFD6EE;
        opacity: 0.7;
        margin: 0;
    }

    .section-heading {
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #EEDEDB;
        font-size: clamp(1.8rem, 3vw, 5.5rem);
        font-weight: 400;
        margin: 0 0 clamp(0.75rem, 2.5vh, 1.5rem);
    }

    p {
        margin: 0;
    }

    /* Home -> About scroll-triggered cover transition */
    .scroll-stack {
        position: relative;
        height: 200vh;
        height: 200dvh;
    }

    /* Home */
    #home {
        position: sticky;
        top: var(--header-h);
        z-index: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        height: calc(100vh - var(--header-h));
        height: calc(100dvh - var(--header-h));
        padding: 0 clamp(1.25rem,14vw,9rem);
        box-sizing: border-box;
        filter: none;
    }

    .home-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5%;
        width: 100%;
        max-width: var(--content-max);
        margin: 0 auto;
    }

    #text {
        flex: 1;
        max-width: 600px;
    }

    #mypic {
        max-width: 18rem;
        max-height: 28rem;
        flex-shrink: 0;
    }

    #mypic img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
    }

    @media screen and (max-width: 800px) {
        #mypic img {
            display: none;
        }
    }

    #nameflower {
        display: flex;
        gap: 5px;
        align-items: flex-end;
    }

    #greetings {
        font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        color: #CFD6EE;
        opacity: 0.7;
        font-size: clamp(1.5rem, 3vw, 3.5rem);
        padding-bottom: 1.5%;
    }

    #name {
        font-family: Georgia, 'Times New Roman', Times, serif;
        color: #EEDEDB;
        font-size: clamp(2.5rem, 5vw, 5.5rem);
        margin: 0;
    }

    #introduction {
        color: #CFD6EE;
        font-size: clamp(1.2rem, 1.6vw, 3.5rem);
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        line-height: 1.5;
    }

    /* About */
    #about {
        position: sticky;
        top: var(--header-h);
        z-index: 2;
        display: flex;
        justify-content: center;
        padding: 0 clamp(1.25rem, 14vw, 9rem);
        height: calc(100vh - var(--header-h));
        height: calc(100dvh - var(--header-h));
        box-sizing: border-box;
        background-color: #1E1E2E;
        transform: translateY(100%);
        will-change: transform;
    }

    /* Softens About's leading edge as it slides over Home, instead of a hard cut line. */
    #about::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: -60px;
        height: 60px;
        background: linear-gradient(to bottom, rgba(30, 30, 46, 0), rgba(30, 30, 46, 1));
        pointer-events: none;
    }

    .about-content {
        display: flex;
        justify-content: center;
        flex-direction: column;
        width: min(100%, var(--content-max));
        margin: 0 auto;   
    }

    #about .eyebrow,
    #about .section-heading {
        align-self: center;
        text-align: center;
    }

    .text {
        color: #CFD6EE;
        font-size: clamp(1rem, 1.2vw, 3.5rem);
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        line-height: 1.5;
        width: 100%;
        margin: 0;
    }

    /* Skills */
    #skills {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 clamp(1.25rem, 14vw, 9rem);
        min-height: calc(100vh - var(--header-h));
        min-height: calc(100dvh - var(--header-h));
        box-sizing: border-box;
    }

    .skills-inner {
        max-width: var(--content-max);
        margin: 0 auto;
        width: 100%;
    }

    .heading {
        margin: 0;
        text-align: center;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: clamp(1.5rem, 8vw, 8rem);
        row-gap: clamp(0.75rem, 4vh, 3.5rem);
    }

    .skill-group h2 {
        margin: 0 0 clamp(0.4rem, 2vh, 1.25rem);
        color: #EEDEDB;
        font: clamp(1rem, 1vw + 1.4vh, 1.65rem) Georgia, 'Times New Roman', serif;
        font-weight: 400;
    }

    .skill-group ul {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(0.35rem, 1vh, 0.75rem);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .skill-group li {
        padding: clamp(0.25rem, 1vh, 0.48rem) clamp(0.5rem, 1.5vw, 0.9rem);
        border: 1px solid rgba(207, 214, 238, 0.4);
        border-radius: 999px;
        color: #CFD6EE;
        font: clamp(0.72rem, 0.5vw + 0.9vh, 0.92rem) 'Lucida Sans', 'Lucida Grande', sans-serif;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .skill-group li:hover {
        color: #1E1E2E;
        background: #CFD6EE;
    }

    @media (max-width: 600px) {
        .skills-grid {
            column-gap: clamp(1rem, 5vw, 2rem);
        }
    }

    @media (max-width: 480px) {
        .skills-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Experiences */
    #experiences {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: calc(100vh - var(--header-h));
        min-height: calc(100dvh - var(--header-h));
        padding: 0 clamp(1.25rem, 14vw, 9rem);
        box-sizing: border-box;
    }

    .experiences-heading {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: var(--content-max);
        margin: 0 auto;
    }

    /* Projects */
    #projects {
        display: grid;
        place-items: center;
        min-height: calc(100vh - var(--header-h));
        min-height: calc(100dvh - var(--header-h));
        padding: clamp(1.5rem, 6vh, 3rem) clamp(1.25rem, 14vw, 9rem);
        box-sizing: border-box;
        text-align: center;
    }
</style>
